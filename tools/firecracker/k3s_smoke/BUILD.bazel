# Smoke test for //tools/firecracker:firecracker_k3s_test.
#
# Boots a single-node k3s server inside a firecracker microVM and
# asserts the guest-side `k3s_smoke` binary can read the kubeconfig
# AND `k3s kubectl get nodes` shows a Ready node. Run with:
#   bazel test --config=kvm //tools/firecracker/k3s_smoke:k3s_smoke_test
# Tagged `requires-kvm` so KVM-less hosts skip via
#   --test_tag_filters=-requires-kvm

load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/firecracker:defs.bzl", "firecracker_k3s_test")

go_library(
    name = "k3s_smoke_lib",
    srcs = ["main.go"],
    importpath = "aquaduct.dev/weft-operator/tools/firecracker/k3s_smoke",
    visibility = ["//visibility:private"],
)

# Static link — k3s rootfs has busybox + the k3s binary and no libc.
# rules_go produces static binaries by default for cgo-free Go code,
# so no extra linkmode='external' / cgo=0 dance is needed here.
go_binary(
    name = "k3s_smoke",
    embed = [":k3s_smoke_lib"],
    visibility = ["//visibility:public"],
)

firecracker_k3s_test(
    name = "k3s_smoke_test",
    scenario = "k3s_smoke",
    test_binary = ":k3s_smoke",
    timeout_seconds = 300,
)
