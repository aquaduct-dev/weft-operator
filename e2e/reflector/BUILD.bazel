# End-to-end test for WeftLocalDNSReflector: proves traffic to a public
# weft hostname is served inside the cluster.
#
# A single-node k3s boots in an airgapped firecracker microVM (see
# //tools/firecracker), with the operator installed from the real chart and
# weft built from source (@aquaduct_weft). The guest binary then drives the
# scenario in scenario.go: a registry is published as
# registry.weft-e2e.test (a name that cannot resolve anywhere but through
# the reflector), a pod resolves it, verifies its certificate using only the
# system trust store, pushes an image, a second pod is started from that
# image (containerd pulling through the node agent's /etc/hosts + certs.d
# entries), and the registry's access log must show every request arriving
# from the reflector proxy.
#
#   bazel test --config=kvm //e2e/reflector:reflector_test

load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_helm//helm:defs.bzl", "helm_template")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//:pkg.bzl", "pkg_tar")
load("//tools/firecracker:defs.bzl", "firecracker_k3s_test")

go_library(
    name = "reflector_lib",
    srcs = [
        "client.go",
        "default_scenario.go",
        "kube.go",
        "main.go",
        "scenario.go",
    ],
    importpath = "aquaduct.dev/weft-operator/e2e/reflector",
    visibility = ["//visibility:private"],
    deps = [
        "//api/v1alpha1",
        "//internal/clusterharness",
        "//internal/pki",
        "@io_k8s_api//admissionregistration/v1:admissionregistration",
        "@io_k8s_api//apps/v1:apps",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/api/errors",
        "@io_k8s_apimachinery//pkg/api/meta",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_apimachinery//pkg/types",
        "@io_k8s_apimachinery//pkg/util/intstr",
        "@io_k8s_client_go//kubernetes",
        "@io_k8s_client_go//kubernetes/scheme",
        "@io_k8s_client_go//tools/clientcmd",
        "@io_k8s_sigs_controller_runtime//pkg/client",
    ],
)

# Static: the microVM rootfs has no libc, and the same binary is the
# in-pod client and the content of the image it pushes.
go_binary(
    name = "reflectore2e",
    embed = [":reflector_lib"],
    pure = "on",
    static = "on",
    visibility = ["//visibility:public"],
)

# --- images preloaded into the VM (it has no network) ----------------------

# Client image: alpine (so it has a normal system trust store for the
# webhook to overlay) + the e2e binary at /e2e.
pkg_tar(
    name = "client_layer",
    files = {":reflectore2e": "e2e"},
    mode = "0755",
)

oci_image(
    name = "client_image",
    base = "@alpine_linux_amd64",
    entrypoint = ["/e2e"],
    tars = [":client_layer"],
)

# weft from source, packaged the same way as weft's own container/BUILD.
pkg_tar(
    name = "weft_layer",
    srcs = ["@aquaduct_weft//:weft"],
    package_dir = "/usr/bin",
)

oci_image(
    name = "weft_image",
    base = "@alpine_linux_amd64",
    entrypoint = ["/usr/bin/weft"],
    tars = [":weft_layer"],
)

# k3s hard-codes this pause image; a sleeping alpine stands in for it.
oci_image(
    name = "pause_image",
    base = "@alpine_linux_amd64",
    entrypoint = [
        "/bin/sh",
        "-c",
        "trap : TERM INT; sleep infinity & wait",
    ],
)

[
    (
        oci_load(
            name = name + "_load",
            image = image,
            repo_tags = [tag],
        ),
        filegroup(
            name = name + "_tar",
            srcs = [":" + name + "_load"],
            output_group = "tarball",
        ),
    )
    for name, image, tag in [
        ("pause", ":pause_image", "docker.io/rancher/mirrored-pause:3.6"),
        ("coredns", "@k3s_coredns_linux_amd64", "docker.io/rancher/mirrored-coredns-coredns:1.10.1"),
        ("registry", "@registry_linux_amd64", "docker.io/library/registry:2.8.3"),
        ("operator", "//cmd:weft_operator_image_amd64", "ghcr.io/aquaduct-dev/weft-operator:e2e"),
        ("weft", ":weft_image", "ghcr.io/aquaduct-dev/weft:e2e"),
        ("client", ":client_image", "ghcr.io/aquaduct-dev/weft-operator-e2e-client:e2e"),
    ]
]

# --- manifests and files baked into the VM rootfs ---------------------------

# The operator, rendered from the real chart with the preloaded images
# (applied by the scenario, see extra_files below).
helm_template(
    name = "operator_manifest",
    chart = "//chart:weft_operator",
    opts = [
        "--namespace=weft-system",
        "--name-template=weft-operator",
    ],
    values = ["e2e-values.yaml"],
)

# The same, with the operator's cluster-default reflector switched off.
helm_template(
    name = "operator_manifest_no_default",
    chart = "//chart:weft_operator",
    opts = [
        "--namespace=weft-system",
        "--name-template=weft-operator",
    ],
    values = [
        "e2e-values.yaml",
        "no-default-reflector.yaml",
    ],
)

# The node's system trust store (the VM rootfs otherwise has none). Copied
# into bazel-out: external-repo files can vanish between invocations.
genrule(
    name = "node_ca_bundle",
    srcs = ["@mozilla_ca_bundle//file"],
    outs = ["ca-certificates.crt"],
    cmd = "cp -L $< $@",
)

genrule(
    name = "gateway_api_crds",
    srcs = ["@gateway_api_experimental_install//file"],
    outs = ["gateway-api-crds.yaml"],
    cmd = "cp -L $< $@",
)

firecracker_k3s_test(
    name = "reflector_test",
    # The scenario applies these itself: the chart render has no namespace
    # on its objects (applied with -n weft-system), and the Gateway API CRDs
    # are too large for the init's client-side apply (applied server-side).
    extra_files = {
        ":gateway_api_crds": "/etc/e2e/gateway-api-crds.yaml",
        ":node_ca_bundle": "/etc/ssl/certs/ca-certificates.crt",
        # A hand-made reflector is the subject here; keep the default off.
        ":operator_manifest_no_default": "/etc/e2e/weft-operator.yaml",
    },
    extra_images = {
        ":pause_tar": "pause.tar",
        ":coredns_tar": "coredns.tar",
        ":registry_tar": "registry.tar",
        ":operator_tar": "operator.tar",
        ":weft_tar": "weft.tar",
        ":client_tar": "client.tar",
    },
    extra_manifests = {
        "00-namespaces.yaml": "00-namespaces.yaml",
    },
    mem_mib = 4096,
    scenario = "reflector",
    size_mb = 8192,
    test_binary = ":reflectore2e",
    timeout_seconds = 1800,
    vcpus = 4,
)

# The chart's defaults: the operator must create a cluster-default
# allHostnames reflector that serves a tunnelled hostname with nobody
# creating a reflector, and remove it again when the chart value turns it off.
firecracker_k3s_test(
    name = "default_reflector_test",
    extra_files = {
        ":gateway_api_crds": "/etc/e2e/gateway-api-crds.yaml",
        ":node_ca_bundle": "/etc/ssl/certs/ca-certificates.crt",
        ":operator_manifest": "/etc/e2e/weft-operator.yaml",
        ":operator_manifest_no_default": "/etc/e2e/weft-operator-default-disabled.yaml",
    },
    extra_images = {
        ":pause_tar": "pause.tar",
        ":coredns_tar": "coredns.tar",
        ":registry_tar": "registry.tar",
        ":operator_tar": "operator.tar",
        ":weft_tar": "weft.tar",
        ":client_tar": "client.tar",
    },
    extra_manifests = {
        "00-namespaces.yaml": "00-namespaces.yaml",
    },
    mem_mib = 4096,
    scenario = "default-reflector",
    size_mb = 8192,
    test_binary = ":reflectore2e",
    timeout_seconds = 1800,
    vcpus = 4,
)
