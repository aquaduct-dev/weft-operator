# End-to-end test for WeftLocalDNSReflector: proves traffic to a public
# weft hostname is served inside the cluster.
#
# A single-node k3s boots in an airgapped firecracker microVM (see
# @rules_firecracker), with the operator installed from the real chart and
# weft built from source (@aquaduct_weft). The guest binary then drives the
# scenario in scenario.go: a registry is published as
# registry.weft-e2e.test (a name that cannot resolve anywhere but through
# the reflector), a pod resolves it, verifies its certificate using only the
# system trust store, pushes an image, a second pod is started from that
# image (containerd pulling through the node agent's /etc/hosts + certs.d
# entries), and the registry's access log must show every request arriving
# from the reflector proxy.
#
#   bazel test --config=kvm //e2e/reflector:reflector_test

load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_helm//helm:defs.bzl", "helm_template")
load("//e2e:defs.bzl", "e2e_binary_image", "weft_e2e_test")

go_library(
    name = "reflector_lib",
    srcs = [
        "client.go",
        "default_scenario.go",
        "kube.go",
        "main.go",
        "scenario.go",
    ],
    importpath = "aquaduct.dev/weft-operator/e2e/reflector",
    visibility = ["//visibility:private"],
    deps = [
        "//api/v1alpha1",
        "//internal/clusterharness",
        "//internal/pki",
        "@io_k8s_api//admissionregistration/v1:admissionregistration",
        "@io_k8s_api//apps/v1:apps",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/api/errors",
        "@io_k8s_apimachinery//pkg/api/meta",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_apimachinery//pkg/types",
        "@io_k8s_apimachinery//pkg/util/intstr",
        "@io_k8s_client_go//kubernetes",
        "@io_k8s_client_go//kubernetes/scheme",
        "@io_k8s_client_go//tools/clientcmd",
        "@io_k8s_sigs_controller_runtime//pkg/client",
    ],
)

# Static: the microVM rootfs has no libc, and the same binary is the
# in-pod client and the content of the image it pushes.
go_binary(
    name = "reflectore2e",
    embed = [":reflector_lib"],
    pure = "on",
    static = "on",
    visibility = ["//visibility:public"],
)

# --- images preloaded into the VM (it has no network) ----------------------
# The common ones (operator, weft, pause, CoreDNS, ...) come from
# //e2e/images via weft_e2e_test; these are this scenario's own.

# Client image: alpine (so it has a normal system trust store for the
# webhook to overlay) + the e2e binary at /e2e.
e2e_binary_image(
    name = "client",
    binary = ":reflectore2e",
    tag = "ghcr.io/aquaduct-dev/weft-operator-e2e-client:e2e",
)

# --- manifests and files baked into the VM rootfs ---------------------------

# The operator, rendered from the real chart with the preloaded images
# (applied by the scenario, see extra_files below).
helm_template(
    name = "operator_manifest",
    chart = "//chart:weft_operator",
    opts = [
        "--namespace=weft-system",
        "--name-template=weft-operator",
    ],
    values = ["e2e-values.yaml"],
)

# The same, with the operator's cluster-default reflector switched off.
helm_template(
    name = "operator_manifest_no_default",
    chart = "//chart:weft_operator",
    opts = [
        "--namespace=weft-system",
        "--name-template=weft-operator",
    ],
    values = [
        "e2e-values.yaml",
        "no-default-reflector.yaml",
    ],
)

weft_e2e_test(
    name = "reflector_test",
    # The scenario applies this itself: the chart render has no namespace on
    # its objects (applied with -n weft-system).
    extra_files = {
        # A hand-made reflector is the subject here; keep the default off.
        ":operator_manifest_no_default": "/etc/e2e/weft-operator.yaml",
    },
    extra_images = {
        "//e2e/images:registry_tar": "registry.tar",
        ":client_tar": "client.tar",
    },
    extra_manifests = {
        "00-namespaces.yaml": "00-namespaces.yaml",
    },
    scenario = "reflector",
    test_binary = ":reflectore2e",
)

# The chart's defaults: the operator must create a cluster-default
# allHostnames reflector that serves a tunnelled hostname with nobody
# creating a reflector, and remove it again when the chart value turns it off.
weft_e2e_test(
    name = "default_reflector_test",
    extra_files = {
        ":operator_manifest": "/etc/e2e/weft-operator.yaml",
        ":operator_manifest_no_default": "/etc/e2e/weft-operator-default-disabled.yaml",
    },
    extra_images = {
        "//e2e/images:registry_tar": "registry.tar",
        ":client_tar": "client.tar",
    },
    extra_manifests = {
        "00-namespaces.yaml": "00-namespaces.yaml",
    },
    scenario = "default-reflector",
    test_binary = ":reflectore2e",
)
