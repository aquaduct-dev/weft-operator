# Images and node files shared by every e2e microVM (they are airgapped, so
# everything a pod runs is preloaded under the tag the manifests use).
#
# Each image is exposed as `:<name>_tar` (an image tarball for
# firecracker_k3s_test's extra_images); e2e/defs.bzl's weft_e2e_test
# preloads all of COMMON_IMAGES.

load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//:pkg.bzl", "pkg_tar")

package(default_visibility = ["//e2e:__subpackages__"])

# weft from source, packaged the same way as weft's own container/BUILD.
pkg_tar(
    name = "weft_layer",
    srcs = ["@aquaduct_weft//:weft"],
    package_dir = "/usr/bin",
)

oci_image(
    name = "weft_image",
    base = "@alpine_linux_amd64",
    entrypoint = ["/usr/bin/weft"],
    tars = [":weft_layer"],
)

# k3s hard-codes this pause image; a sleeping alpine stands in for it.
oci_image(
    name = "pause_image",
    base = "@alpine_linux_amd64",
    entrypoint = [
        "/bin/sh",
        "-c",
        "trap : TERM INT; sleep infinity & wait",
    ],
)

[
    (
        oci_load(
            name = name + "_load",
            image = image,
            repo_tags = [tag],
        ),
        filegroup(
            name = name + "_tar",
            srcs = [":" + name + "_load"],
            output_group = "tarball",
        ),
    )
    for name, image, tag in [
        ("pause", ":pause_image", "docker.io/rancher/mirrored-pause:3.6"),
        ("coredns", "@k3s_coredns_linux_amd64", "docker.io/rancher/mirrored-coredns-coredns:1.10.1"),
        ("local_path_provisioner", "@k3s_local_path_provisioner_linux_amd64", "docker.io/rancher/local-path-provisioner:v0.0.28"),
        ("busybox", "@k3s_busybox_linux_amd64", "docker.io/rancher/mirrored-library-busybox:1.36.1"),
        ("operator", "//cmd:weft_operator_image_amd64", "ghcr.io/aquaduct-dev/weft-operator:e2e"),
        ("weft", ":weft_image", "ghcr.io/aquaduct-dev/weft:e2e"),
        ("registry", "@registry_linux_amd64", "docker.io/library/registry:2.8.3"),
        ("vpa_recommender", "@vpa_recommender_linux_amd64", "registry.k8s.io/autoscaling/vpa-recommender:1.7.0"),
        ("vpa_updater", "@vpa_updater_linux_amd64", "registry.k8s.io/autoscaling/vpa-updater:1.7.0"),
        ("vpa_admission_controller", "@vpa_admission_controller_linux_amd64", "registry.k8s.io/autoscaling/vpa-admission-controller:1.7.0"),
    ]
]

# --- node files ------------------------------------------------------------
# Copied into bazel-out: external-repo files can vanish between invocations.

# The node's system trust store (the VM rootfs otherwise has none).
genrule(
    name = "node_ca_bundle",
    srcs = ["@mozilla_ca_bundle//file"],
    outs = ["ca-certificates.crt"],
    cmd = "cp -L $< $@",
)

# Gateway API, experimental channel (adds TCPRoute/TLSRoute/UDPRoute).
genrule(
    name = "gateway_api_crds",
    srcs = ["@gateway_api_experimental_install//file"],
    outs = ["gateway-api-crds.yaml"],
    cmd = "cp -L $< $@",
)

# Gateway API, standard channel only.
genrule(
    name = "gateway_api_standard_crds",
    srcs = ["@gateway_api_standard_install//file"],
    outs = ["gateway-api-standard-crds.yaml"],
    cmd = "cp -L $< $@",
)

# helm, for scenarios that need chart behavior against a live cluster.
genrule(
    name = "helm",
    srcs = ["@helm_linux_amd64//:linux-amd64/helm"],
    outs = ["helm-bin"],
    cmd = "cp -L $< $@ && chmod +x $@",
)
