load("@rules_helm//helm:defs.bzl", "helm_chart")

helm_chart(
    name = "weft_operator",
    chart = "Chart.yaml",
    # CRDs go through `templates`, not `crds`. Helm's `crds/` directory
    # is install-only — `helm upgrade` never refreshes it — which means
    # schema additions silently get pruned on existing clusters until
    # someone manually `kubectl apply`s the new CRD. Treating CRDs as
    # release-managed templates means upgrades update them like any
    # other resource, at the cost of helm uninstall deleting them
    # (which we want for dev clusters; long-lived prod tenants should
    # add helm.sh/resource-policy: keep before relying on the CRDs).
    images = ["//cmd:weft_operator_image_push"],
    registry_url = "oci://ghcr.io/aquaduct-dev/charts",
    templates = [
        "//chart/templates:deployment.yaml",
        "//chart/templates:rolebinding.yaml",
        "//chart/templates:role.yaml",
        "//chart/templates:serviceaccount.yaml",
        "//chart/templates:_helpers.tpl",
        "//chart/templates:gatewayclass.yaml",
        "//api/v1alpha1:generated.crds",
    ],
    upgrade_opts = [
        "--namespace=weft-system",
        "--install",
        "--create-namespace",
    ],
    values = "values.yaml",
    visibility = ["//visibility:public"],
)
